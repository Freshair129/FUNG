# Supabase project credentials (public — safe to embed in frontend bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Native desktop authorization reads these at runtime; never use a service-role key.
FUNG_SUPABASE_URL=https://your-project.supabase.co
FUNG_SUPABASE_ANON_KEY=your-anon-key

# Optional: override the landing page's Windows desktop download link
# (src/lib/release.ts). Defaults to the upstream FUNG-Releases asset if unset —
# set this when deploying a fork so the download CTA doesn't point at someone
# else's GitHub account.
# VITE_RELEASE_DOWNLOAD_URL=https://github.com/your-org/your-releases-repo/releases/latest/download/FUNG-windows-x64-setup.exe

# Whisper worker profile: cpu (default) or gpu. gpu needs the CUDA 12 / cuDNN 9 DLLs staged
# into runtime/cuda12/bin by scripts/stage_gpu_runtime.ps1.
# Model profile: turbo (default, large-v3-turbo) or medium (lower-resource path).
# medium + gpu defaults to int8_float16; medium + cpu uses int8.
# large-v3 is qualification-only and is not a desktop profile.
# FUNG_WHISPER_MODEL_PROFILE=medium
# FUNG_TRANSCRIPTION_COMPUTE_TYPE=int8_float16
# FUNG_TRANSCRIPTION_PROFILE=gpu

# Optional local speaker diarization for mixed audio. The gated Hugging Face
# model is fetched once after accepting both pyannote licenses; never commit a
# token here. Set FUNG_HF_TOKEN or HF_TOKEN in the process/user environment.
# Optional shared cache override: FUNG_HF_HOME=C:\path\to\shared\huggingface
